# ============================================================
# AVENTRA — Environment Variables
# Copy this file to apps/web/.env.local and fill in values.
# NEVER commit .env.local to git.
# ============================================================

# ------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# Get these from: https://neon.tech → Your Project → Connection Details
# "Pooled connection" → DATABASE_URL
# "Direct connection" → DIRECT_DATABASE_URL
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/aventra?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/aventra?sslmode=require"

# ------------------------------------------------------------
# EMAIL (Resend)
# Get API key from: https://resend.com → API Keys
# ------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
