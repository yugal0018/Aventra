{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_APP_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "DIRECT_DATABASE_URL",
        "PGHOST",
        "PGHOST_UNPOOLED",
        "PGUSER",
        "PGDATABASE",
        "PGPASSWORD",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_URL_NO_SSL",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_USER",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_DATABASE",
        "NEON_PROJECT_ID",
        "NEON_AUTH_BASE_URL",
        "VITE_NEON_AUTH_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "RESEND_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "clean": {
      "cache": false
    }
  }
}
